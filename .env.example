# Copy to .env and adjust. Docker Compose reads .env from the directory you run it in,
# so pass `--env-file .env` when running from the repository root.

# Host port for the PostgreSQL container in deploy/compose.yaml.
CAVEA_PG_PORT=5432

# cavea-server settings (docs/08-server.md §13).
CAVEA_LISTEN=127.0.0.1:8080
CAVEA_LOG=info
# Required. The server migrates this database at startup.
CAVEA_DATABASE_URL=postgres://cavea:cavea@127.0.0.1:5432/cavea
CAVEA_DB_POOL=16
# This node's name for event ownership; defaults to the host name.
# CAVEA_NODE_ID=node-1
CAVEA_LEASE_SECS=15
CAVEA_HEARTBEAT_SECS=5
# The operator's key for /v1/workspaces: 32 to 512 printable ASCII characters,
# for example `openssl rand -hex 32`. No default; unset, those endpoints refuse
# every request.
# CAVEA_ADMIN_KEY=
